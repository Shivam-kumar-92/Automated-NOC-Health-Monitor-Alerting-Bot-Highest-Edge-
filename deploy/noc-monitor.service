[Unit]
Description=Automated NOC Health Monitor & Alerting Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nocmonitor
Group=nocmonitor
WorkingDirectory=/opt/noc-health-monitor
EnvironmentFile=-/opt/noc-health-monitor/.env
ExecStart=/usr/bin/python3 /opt/noc-health-monitor/monitor.py --config /opt/noc-health-monitor/config.json --dashboard --dashboard-host 0.0.0.0 --dashboard-port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/noc-health-monitor/data /opt/noc-health-monitor/logs

[Install]
WantedBy=multi-user.target
