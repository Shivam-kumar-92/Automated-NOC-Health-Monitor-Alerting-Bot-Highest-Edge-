# Copy this file to .env and fill in any alert channels you want to activate.
# Environment variables override values in config.json and keep secrets out of Git.

# Discord Webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Slack Incoming Webhook URL (Slack App -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Telegram Bot Token (from @BotFather) & Target Chat/Channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
